# MarketData.app API token (server-side only)
MARKETDATA_TOKEN=

# Vercel Postgres / Neon — set automatically when you connect Storage in Vercel
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Protect cron + migration endpoints in production
CRON_SECRET=
MIGRATE_SECRET=

# Development only: use unauthenticated AAPL demo endpoints when no token is set
# DEMO_MODE=true
