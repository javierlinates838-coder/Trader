# MarketData.app — your ONE API key (server-side only, never expose to frontend)
MARKETDATA_TOKEN=

# Optional: passwords you invent yourself (NOT API keys)
# MIGRATE_SECRET=any-random-string
# CRON_SECRET=any-random-string

# Vercel Postgres — auto-set when you add Storage in Vercel dashboard
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Development only: AAPL demo without a token
# DEMO_MODE=true
