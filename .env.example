# MarketData.app API token (server-side only — never expose to frontend)
MARKETDATA_TOKEN=

# Vercel Postgres / Neon (auto-set when you add Storage in Vercel dashboard)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Protect cron + migration endpoints in production
CRON_SECRET=
MIGRATE_SECRET=

# Development only: use unauthenticated AAPL demo endpoints when no token is set
# DEMO_MODE=true

# FastAPI backend URL (local dev only — scanner runs in Next.js on Vercel)
BACKEND_URL=http://localhost:8000
