# MarketData.app API token (server-side only — never expose to frontend)
MARKETDATA_TOKEN=

# Development only: use unauthenticated AAPL demo endpoints when no token is set
# DEMO_MODE=true

# PostgreSQL (used by FastAPI scanner backend)
DATABASE_URL=postgresql://option1:option1@localhost:5432/option1

# FastAPI backend URL (Next.js proxies scanner requests here)
BACKEND_URL=http://localhost:8000
